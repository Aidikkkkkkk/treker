{
   "expo": {
      "name": "treker",
      "slug": "treker",
      "version": "1.0.0",
      "orientation": "portrait",
      "scheme": "treker",
      "userInterfaceStyle": "dark",
      "icon": "./assets/icon.png",
      "splash": {
         "image": "./assets/background.png",
         "resizeMode": "contain"
      },
      "plugins": [
         [
            "expo-sqlite",
            {
               "enableFTS": true,
               "useSQLCipher": true,
               "android": {
                  "enableFTS": false,
                  "useSQLCipher": false
               }
            }
         ],
         "@react-native-community/datetimepicker"
      ],
      "android": {
         "package": "com.anonymous.treker"
      }
   }
}
